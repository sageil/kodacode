---
export const prerender = true;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Not Found | KodaCode</title>
		<style>
			:root {
				color-scheme: dark;
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
				background: #0a0a0f;
				color: #f0f0f5;
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				background:
					radial-gradient(circle at top, rgba(203, 166, 247, 0.12), transparent 38%),
					linear-gradient(180deg, #0a0a0f 0%, #111118 100%);
			}

			main {
				width: min(34rem, calc(100vw - 3rem));
				padding: 2.5rem;
				border: 1px solid #1e1e2e;
				border-radius: 20px;
				background: rgba(17, 17, 24, 0.9);
				box-shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
			}

			h1 {
				margin: 0 0 0.75rem;
				font-size: clamp(2rem, 8vw, 3rem);
				line-height: 1.05;
				letter-spacing: -0.03em;
			}

			p {
				margin: 0 0 1.25rem;
				line-height: 1.7;
				color: #c0c0cc;
			}

			.actions {
				display: flex;
				gap: 0.75rem;
				flex-wrap: wrap;
			}

			a {
				display: inline-block;
				padding: 0.7rem 1rem;
				border-radius: 10px;
				text-decoration: none;
				font-weight: 600;
			}

			a.primary {
				background: #cba6f7;
				color: #0a0a0f;
			}

			a.secondary {
				border: 1px solid #2b2b3d;
				color: #f0f0f5;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Page not found.</h1>
			<p>The documentation page you requested does not exist or has moved.</p>
			<div class="actions">
				<a class="primary" href="/">Home</a>
				<a class="secondary" href="/getting-started/introduction/">Getting Started</a>
			</div>
		</main>
	</body>
</html>
